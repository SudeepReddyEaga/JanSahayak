# ==============================================================================
# Environment Configuration Template
# Copy to .env and customize for local dev or Docker Compose deployment
# ==============================================================================

# --- Runtime Execution Mode ("microservice_http" for Docker, "local_inproc" for single-process testing) ---
ORCHESTRATION_MODE=microservice_http

# --- PostgreSQL Relational + JSONB Database ---
DATABASE_URL=postgresql+psycopg2://scheme_user:scheme_pass@postgres:5432/scheme_guide_db

# --- Redis Cache & Working Memory ---
REDIS_URL=redis://redis:6379/0
REDIS_EXACT_TTL_SECONDS=3600
REDIS_SEMANTIC_TTL_SECONDS=3600
REDIS_RAG_TTL_SECONDS=1800
REDIS_PROFILE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.85

# --- Internal Microservice Endpoints ---
PROFILE_MEMORY_SERVICE_URL=http://profile-memory-service:8001
RAG_RETRIEVAL_SERVICE_URL=http://rag-retrieval-service:8002
AGENT_ORCHESTRATOR_SERVICE_URL=http://agent-orchestrator-service:8003
VOICE_SPEECH_SERVICE_URL=http://voice-speech-service:8004
API_GATEWAY_URL=http://api-gateway:8000

# --- LLM Backend Configuration ---
# Supported: "deterministic" (zero-API-key offline high-accuracy mode), "openai", "gemini", "ollama"
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- RAG Configuration ---
RAG_TOP_K=10
RAG_MIN_SCORE=0.05

